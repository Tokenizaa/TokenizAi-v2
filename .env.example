# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAPERCLIP_API_URL: Optional URL of the Paperclip orchestration backend (e.g., https://paperclip.internal)
PAPERCLIP_API_URL=""

# PAPERCLIP_API_KEY: Server-side bearer token for Paperclip API (never exposed to browser)
PAPERCLIP_API_KEY=""

# PAPERCLIP_COMPANY_ID: Default Paperclip company workspace identifier
PAPERCLIP_COMPANY_ID=""

# PAPERCLIP_REQUEST_TIMEOUT_MS: Request timeout in milliseconds (default 30000)
PAPERCLIP_REQUEST_TIMEOUT_MS="30000"

# PAPERCLIP_SYNC_INTERVAL_MS: Background sync interval in milliseconds (default 15000)
PAPERCLIP_SYNC_INTERVAL_MS="15000"

# TOKENIZAI_ADMIN_PASSCODE: Passcode protegendo admin integration refresh e ações sensíveis
TOKENIZAI_ADMIN_PASSCODE=""

# TOKENIZAI_SESSION_SECRET: Chave secreta para assinatura de sessões (obrigatório; nunca exponha)
TOKENIZAI_SESSION_SECRET=""

# PORT: Porta do servidor backend (padrão 3000)
PORT=3000

# SUPABASE_URL: URL do projeto Supabase (usada pelo backend e frontend)
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Publishable/anonymous key do Supabase (usada pelo backend para validar JWTs)
SUPABASE_ANON_KEY=""

# VITE_SUPABASE_URL: URL do projeto Supabase (exposta ao frontend)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Publishable/anonymous key do Supabase (exposta ao frontend, nunca service_role)
VITE_SUPABASE_ANON_KEY=""

